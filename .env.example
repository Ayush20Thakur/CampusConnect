# CampusConnect Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# Flask secret key — generate a secure random string for production
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Flask environment: development | production | testing
FLASK_ENV=development
FLASK_DEBUG=1

# SQLite database path (relative to backend directory)
DATABASE_URL=sqlite:///campusconnect.db

# Session cookie settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Cancellation cutoff in hours (appointments must be cancelled this many hours before)
CANCELLATION_CUTOFF_HOURS=2

# Default appointment duration in minutes
DEFAULT_CLINIC_DURATION_MINUTES=30
DEFAULT_ADVISING_DURATION_MINUTES=45

# Demo mode flag — enables fault lab and demo credentials panel
DEMO_MODE=True
